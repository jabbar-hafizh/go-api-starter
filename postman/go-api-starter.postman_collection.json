{
  "info": {
    "name": "go-api-starter",
    "description": "Every endpoint, in the order you would actually use them.\n\nRun Register, then Verify email, then Login, and the rest works: login and refresh save the tokens into the environment automatically and the collection sends the access token on every authenticated call.\n\nEverything uses X-Client-Platform: ios on purpose. Web clients get the refresh token as an httpOnly cookie and nothing in the body, which is right for a browser and awkward in Postman. Native clients get it in the body, where it is visible and easy to work with.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Auth",
      "description": "Sign up, confirm, sign in.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Creates the account and emails a link. No session is issued: the address is verified first, which is what makes linking a Google account to it safe later.\n\nAnswers 201 even if the email fails to send. The account exists by then, so saying otherwise would leave you unable to register again and unable to sign in.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('not verified yet', () => pm.expect(pm.response.json().email_verified).to.be.false);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/verify-email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "verify-email"
              ]
            },
            "description": "Paste the token into the verifyToken environment variable first.\n\nWith SMTP_HOST empty it is in the server log:\n    docker compose logs api | grep 'email not sent'\n\nWith SMTP configured it is in the link in the email.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verifyToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend verification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/verify-email/resend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "verify-email",
                "resend"
              ]
            },
            "description": "Always 204, whether the address is registered, unregistered or already verified: any other answer would let you test which addresses have accounts. A new link retires the earlier ones.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Client-Platform",
                "value": "ios"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Saves the tokens into the environment, so everything after this just works.\n\n403 means the address is not verified yet. 401 means wrong credentials, and it says the same thing whether the account exists or not, on purpose.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.environment.set('accessToken', json.access_token);",
                  "if (json.refresh_token) {",
                  "    // Native clients get it in the body. Web gets a cookie instead, which",
                  "    // is why this collection sends X-Client-Platform: ios throughout.",
                  "    pm.environment.set('refreshToken', json.refresh_token);",
                  "}",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('access token returned', () => pm.expect(pm.response.json().access_token).to.be.a('string'));",
                  "pm.test('expires in 15 minutes', () => pm.expect(pm.response.json().expires_in).to.eql(900));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Client-Platform",
                "value": "ios"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "Spends the old token and issues a new one in the same chain.\n\nSend an already-spent token and the whole chain is revoked: two parties holding one token is indistinguishable from theft, so the session ends for both. Your client must make sure only one refresh is in flight at a time, or three simultaneous 401s will sign the user out.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.environment.set('accessToken', json.access_token);",
                  "if (json.refresh_token) {",
                  "    // Native clients get it in the body. Web gets a cookie instead, which",
                  "    // is why this collection sends X-Client-Platform: ios throughout.",
                  "    pm.environment.set('refreshToken', json.refresh_token);",
                  "}",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('a new refresh token', () => pm.expect(pm.response.json().refresh_token).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the whole chain, not just the token sent, so a copy taken earlier is dead too. Always 204: a client asking to leave must not be told it is still signed in.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "List providers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/providers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "providers"
              ]
            },
            "description": "Both enabled in the database and configured on this server, so you never render a button that cannot work.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in with Google (native)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Client-Platform",
                "value": "ios"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/google/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "google",
                "token"
              ]
            },
            "description": "The mobile path: the app gets an ID token from the Google SDK and posts it here. Verified by signature, issuer, audience allowlist and expiry.\n\nThe browser path cannot be driven from Postman, since it is a redirect to Google. Open this in a browser instead:\n    {{baseUrl}}/v1/auth/google/start",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"{{googleIdToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.environment.set('accessToken', json.access_token);",
                  "if (json.refresh_token) {",
                  "    // Native clients get it in the body. Web gets a cookie instead, which",
                  "    // is why this collection sends X-Client-Platform: ios throughout.",
                  "    pm.environment.set('refreshToken', json.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Me",
      "description": "The signed-in user. Run Login first.",
      "item": [
        {
          "name": "Get me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "me"
              ]
            },
            "description": "auth_methods tells a client whether to offer Set password or Change password, and when to disable unlinking."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('has auth methods', () => pm.expect(pm.response.json().auth_methods).to.be.an('object'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List identities",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/me/identities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "me",
                "identities"
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const list = pm.response.json();",
                  "if (list.length) { pm.environment.set('identityId', list[0].id); }",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Link Google",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/me/identities/google",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "me",
                "identities",
                "google"
              ]
            },
            "description": "Needs no email check: you have already proved you own this account. The unique index on provider and subject is what stops one Google account being attached to two users.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"{{googleIdToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Unlink identity",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/me/identities/{{identityId}}/unlink",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "me",
                "identities",
                "{{identityId}}",
                "unlink"
              ]
            },
            "description": "Refused with 409 when it is the only way left to sign in. Someone who signed up with Google and never set a password would otherwise lock themselves out permanently."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Calculator",
      "description": "Needs a token. Small on purpose: it is the smoke test that proves the auth chain, the contract and the error mapping all hold.",
      "item": [
        {
          "name": "Add (0.1 + 0.2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/calculations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "calculations"
              ]
            },
            "description": "Numbers travel as strings. A JSON number is already a float64 by the time any server code sees it, and 0.1 + 0.2 is wrong by then.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation\": \"add\",\n  \"a\": \"0.1\",\n  \"b\": \"0.2\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('exactly 0.3, not 0.30000000000000004', () => pm.expect(pm.response.json().result).to.eql('0.3'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Subtract",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/calculations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "calculations"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation\": \"subtract\",\n  \"a\": \"100\",\n  \"b\": \"42.5\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('57.5', () => pm.expect(pm.response.json().result).to.eql('57.5'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Multiply (big integers)",
          "request": {
