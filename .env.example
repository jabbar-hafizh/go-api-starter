# App
#
# NOTE ON THE CREDENTIALS BELOW
# The Resend key and the Google OAuth client are filled in on purpose, so that
# cloning this repository is enough to exercise sign-up email and Google
# sign-in without registering anything first. They belong to throwaway test
# accounts and are treated as public.
#
# Nothing with a real blast radius goes here. Production credentials belong in
# .env, which is gitignored, or in whatever secret store the deployment uses.
# Anything committed to this file is in the git history permanently, and
# GitHub's secret scanning may report it to the provider, which can revoke it.
#
APP_ENV=local
APP_LOG_LEVEL=debug
# Where the browser lands after a provider sign-in. While there is no
# frontend yet, http://localhost:8080/docs is a useful stand-in.
APP_BASE_URL=http://localhost:3000
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_BODY_BYTES=1048576
# Exact origins, comma separated. Empty means no browser may call this API.
HTTP_ALLOWED_ORIGINS=http://localhost:3000
# Number of proxies in front. 0 ignores X-Forwarded-For entirely.
HTTP_TRUSTED_PROXY_HOPS=0

# Rate limiting (in-process, so limits are per replica)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_PER_SECOND=20
RATE_LIMIT_IP_BURST=40
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_LOGIN_BURST=5
RATE_LIMIT_RESEND_PER_HOUR=3
RATE_LIMIT_RESEND_BURST=3

# Mobile force upgrade. Empty disables the check.
MIN_CLIENT_VERSION_IOS=
MIN_CLIENT_VERSION_ANDROID=
CLIENT_UPGRADE_MESSAGE="Please update the app to continue."

# Postgres
POSTGRES_DSN=postgres://app:app@localhost:5432/app?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2

# Auth
# Generate with: openssl rand -base64 48
JWT_SECRET=local-development-secret-change-me-in-every-real-environment
JWT_KEY_ID=k1
ACCESS_TOKEN_TTL=15m
EMAIL_TOKEN_TTL=24h
REFRESH_TOKEN_TTL_WEB=168h
REFRESH_TOKEN_TTL_MOBILE=720h

# Contract validation (jangan dinyalakan di production)
VALIDATE_SPEC=true

# Email. Leave SMTP_HOST empty to write the verification token to the log
# instead of sending anything, which is enough for local work.
#
# The sender is provider neutral, so any SMTP server works. Resend is the
# lowest-friction option: sign up, create an API key, and send from
# onboarding@resend.dev without owning a domain. That sender can only reach the
# address the Resend account was registered with; reaching anyone else needs
# your own domain and DNS verification.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_93rQWNkc_BPVL1GN8gkj9VHkt8vLk8naa
SMTP_FROM=onboarding@resend.dev
SMTP_FROM_NAME=go-api-starter
#
# Gmail works too, but costs more to set up and gives less: it needs two-factor
# authentication, then an app password, caps sending near 500 a day, and that
# password is a credential for the whole Google account rather than one service.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=<16-character app password from myaccount.google.com/apppasswords>
#   SMTP_FROM=you@gmail.com

# Google SSO. Leave empty to run without it: the Google endpoints then answer
# 501 and everything else works.
#
# Filled in deliberately, see the note at the top. The registered redirect URI
# is the one below, so it only works against localhost:8080.
# Console: APIs & Services -> Credentials -> OAuth client ID -> Web application
GOOGLE_CLIENT_ID=682867497772-e2r6vqq3pgsfg0nr39s1dcuu1qrskmu5.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URL=http://localhost:8080/v1/auth/google/callback
# Extra audiences accepted from native clients. Defaults to GOOGLE_CLIENT_ID,
# which is what Google puts in aud on every platform when the app passes the
# web client id as its server client id.
GOOGLE_ALLOWED_AUDIENCES=
