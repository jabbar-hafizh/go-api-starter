# App
APP_ENV=local
APP_LOG_LEVEL=debug
APP_BASE_URL=http://localhost:3000
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Postgres
POSTGRES_DSN=postgres://app:app@localhost:5432/app?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2

# Auth
# Generate with: openssl rand -base64 48
JWT_SECRET=local-development-secret-change-me-in-every-real-environment
JWT_KEY_ID=k1
ACCESS_TOKEN_TTL=15m
EMAIL_TOKEN_TTL=24h
REFRESH_TOKEN_TTL_WEB=168h
REFRESH_TOKEN_TTL_MOBILE=720h

# Contract validation (jangan dinyalakan di production)
VALIDATE_SPEC=true

# Google SSO. Leave empty to run without it: the Google endpoints then answer
# 501 and everything else works.
# Console: APIs & Services -> Credentials -> OAuth client ID -> Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/v1/auth/google/callback
# Extra audiences accepted from native clients. Defaults to GOOGLE_CLIENT_ID,
# which is what Google puts in aud on every platform when the app passes the
# web client id as its server client id.
GOOGLE_ALLOWED_AUDIENCES=
